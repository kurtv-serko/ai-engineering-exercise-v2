{
  "name": "farepath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @farepath/api dev\" \"pnpm --filter @farepath/web dev\"",
    "build": "pnpm --filter @farepath/shared build && pnpm --filter @farepath/api build && pnpm --filter @farepath/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "db:reset": "pnpm --filter @farepath/db reset"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
