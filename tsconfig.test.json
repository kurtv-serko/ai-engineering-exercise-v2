{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "apps/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.ts",
    "apps/api/src/testing/**/*"
  ]
}
